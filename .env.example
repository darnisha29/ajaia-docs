# Copy to .env.local (or .env) and fill in.
# Supabase → Project Settings → Data API / API Keys.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key. SERVER ONLY — it bypasses Row-Level Security.
# Never expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookie. Any long random string:
#   openssl rand -hex 32
# Required in production; falls back to a dev-only value when running locally.
SESSION_SECRET=
